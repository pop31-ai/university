#!/bin/sh
# pre-commit hook — единый прогон тестов кампуса.
# Запускается git'ом перед каждым коммитом (через core.hooksPath = scripts/hooks).
# При любом сбое (например, аудит дашборда или QC охвата не зелёный) — коммит блокируется.

root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1

echo "==> pre-commit: запуск тестов кампуса (plan/test_all.js)..."
node plan/test_all.js
status=$?

if [ "$status" -ne 0 ]; then
  echo ""
  echo "x pre-commit: тесты не прошли. Исправь замечания и повтори коммит."
fi

exit $status
